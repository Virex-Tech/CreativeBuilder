# dependências
node_modules/

# builds
dist/
out/
*.tsbuildinfo

# segredos
.env
.env.*

# frames e áudio extraídos pelo ingest-reference (reproduzíveis)
.cache-ingestao/

# MP4 e PNG renderizados
render/out/
render/public/test-*.mp3

# material bruto anexado (vídeos/imagens) — o Claude copia para render/public só o que usar
entrada/*
!entrada/LEIA-ME.md

# código aposentado, aguardando exclusão definitiva
_descontinuado/

# runtime
*.log
.DS_Store
.playwright-mcp/

# mídia copiada para o renderer — original fica em entrada/, o Claude recopia quando precisa
render/public/panda/*.mp4
render/public/app/*/*.mp4
render/public/app/*/*.mov
render/public/broll/*.mp4
render/public/audio/*.mp3
render/public/audio/*.wav
render/public/audio/*.json
render/public/sfx/originais/
# material bruto anexado (vídeos/imagens) — o Claude copia para render/public só o que usar
entrada/*
!entrada/LEIA-ME.md

# takes gravados preparados (tools/takes.mjs): vídeo de pessoa real, pesado — fica no computador
render/public/takes/

# OAuth do Codex (server-side) — NUNCA versionar
.codex-server/

# OAuth do Higgsfield (server-side) — NUNCA versionar
.higgsfield-server/

# gravacoes do app ja borradas (tela-cheia/ e mockup/, por idioma) — 170 MB, o original esta
# em entrada/<idioma>/gravacoes/ e o Claude regenera com tools/borrar-ocr.mjs
render/public/app/**/*.mp4
render/public/app/**/*.png
!render/public/app/*/icone.png

# dados de idioma que o tesseract.js baixa sozinho na primeira execucao
*.traineddata

# modelo de rosto (baixado por tools/rosto.py)
tools/modelos/*.onnx

# props do Remotion: gerados de cada spec por `spec-tool props`, não são fonte
render/specs/**/props/
# roteiros que viram locução; o texto fica no proprio spec (audio.voiceover.script)
.cache-tts/
