// Creative Engine — internal team tool.
//
// The load-bearing idea: a Creative is an identity, and its content lives in an ordered
// list of CreativeVersion rows holding the spec JSON. Nothing ever edits a spec in place,
// so "what did this look like when it performed well" always has an answer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  // No billing and no self-signup: an admin creates accounts for the team.
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now()) @map("created_at")

  apps       App[]
  creatives  Creative[]
  references ReferenceAsset[]
  posts      Post[]

  @@map("users")
}

enum Role {
  ADMIN
  MEMBER
}

/// A product being marketed. Everything else hangs off this.
model App {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  slug      String   @unique
  niche     String?
  /// DirectorProfile: pacing, transitions, caption style and the `never` list.
  /// Stored as JSON so the team edits it in the UI without a migration.
  director  Json     @default("{}")
  brandKit  Json     @default("{}") @map("brand_kit")
  /// Config do pipeline "Concorrentes": concorrentes (páginas do Facebook), termos de busca,
  /// critério de vencedor e destino na Meta. JSON pra equipe editar sem migration.
  pipeline  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  creatives     Creative[]
  templates     Template[]
  references    ReferenceAsset[]
  assets        Asset[]
  competitorAds CompetitorAd[]
  accounts      SocialAccount[]
  posts         Post[]
  takes         Take[]

  @@index([ownerId])
  @@map("apps")
}

/// A reference video ingested for its STRUCTURE. Frames and audio are extracted so the
/// model can read it; the source is never reused as footage.
model ReferenceAsset {
  id        String    @id @default(uuid()) @db.Uuid
  appId     String    @map("app_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  sourceUrl String?   @map("source_url")
  filePath  String?   @map("file_path")
  status    JobStatus @default(QUEUED)
  /// Output of tools/ingest-reference.mjs: cuts, avgShotSec, frame list.
  manifest  Json      @default("{}")
  /// The derived structure: beats with role, timing and on-screen text.
  blueprint Json?
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")

  app           App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates     Template[]
  competitorAds CompetitorAd[]
  posts         Post[]

  @@index([appId, createdAt(sort: Desc)])
  @@map("reference_assets")
}

/// A reusable structure ("Treino aleatório", "5 semanas"), usually derived from a reference.
model Template {
  id          String   @id @default(uuid()) @db.Uuid
  appId       String?  @map("app_id") @db.Uuid
  referenceId String?  @map("reference_id") @db.Uuid
  name        String
  niche       String?
  blueprint   Json
  createdAt   DateTime @default(now()) @map("created_at")

  // Optional: a niche template ("5 semanas") can be reused across apps, not only the one
  // whose reference produced it.
  app       App?            @relation(fields: [appId], references: [id], onDelete: Cascade)
  reference ReferenceAsset? @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  creatives Creative[]

  @@index([appId])
  @@map("templates")
}

model Creative {
  id         String         @id @default(uuid()) @db.Uuid
  appId      String         @map("app_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  templateId String?        @map("template_id") @db.Uuid
  name       String
  locale     String         @default("pt-BR")
  outputKind OutputKind     @default(VIDEO) @map("output_kind")
  status     CreativeStatus @default(DRAFT)

  /// Lineage. `mutation` names the ONE dimension that changed from the parent — this is
  /// what later lets a metric be attributed to a cause instead of to a whole rewrite.
  parentId String? @map("parent_id") @db.Uuid
  mutation String?

  /// Groups the same creative across locales, so pt/en/es are siblings rather than
  /// unrelated rows competing in the same baseline.
  localeGroupId String? @map("locale_group_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app           App               @relation(fields: [appId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  parent        Creative?         @relation("Lineage", fields: [parentId], references: [id], onDelete: SetNull)
  children      Creative[]        @relation("Lineage")
  versions      CreativeVersion[]
  renders       RenderJob[]
  competitorAds CompetitorAd[]
  posts         Post[]

  @@index([appId, createdAt(sort: Desc)])
  @@index([parentId])
  @@index([localeGroupId])
  @@map("creatives")
}

enum OutputKind {
  VIDEO
  IMAGE
  CAROUSEL
}

enum CreativeStatus {
  DRAFT
  READY
  APPROVED
  ARCHIVED
}

/// Immutable snapshot of a spec. Editing always appends.
model CreativeVersion {
  id         String   @id @default(uuid()) @db.Uuid
  creativeId String   @map("creative_id") @db.Uuid
  version    Int
  spec       Json
  /// sha256 of the spec — lets a render be skipped when nothing actually changed.
  specHash   String   @map("spec_hash")
  createdBy  String   @default("human") @map("created_by")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  creative Creative    @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  renders  RenderJob[]

  @@unique([creativeId, version])
  @@index([specHash])
  @@map("creative_versions")
}

/// Any file we hold: generated clip, uploaded footage, voiceover, music, rendered output.
model Asset {
  id                   String    @id @default(uuid()) @db.Uuid
  appId                String    @map("app_id") @db.Uuid
  kind                 AssetKind
  /// sha256 of prompt+params for generated assets — the cache key that stops us paying
  /// twice for the same b-roll.
  contentHash          String?   @map("content_hash")
  path                 String
  mimeType             String?   @map("mime_type")
  sizeBytes            Int?      @map("size_bytes")
  durationMs           Int?      @map("duration_ms")
  prompt               String?
  provider             String?
  model                String?
  creditsUsed          Float?    @map("credits_used")
  /// Provider URLs expire (Higgsfield ~7 days); after this the local copy is the only one.
  providerUrlExpiresAt DateTime? @map("provider_url_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, contentHash])
  @@index([appId, kind])
  @@map("assets")
}

enum AssetKind {
  GENERATED_VIDEO
  GENERATED_IMAGE
  UPLOAD
  SCREEN_RECORDING
  VOICEOVER
  MUSIC
  RENDER
  REFERENCE_FRAME
}

model RenderJob {
  id                String     @id @default(uuid()) @db.Uuid
  creativeId        String     @map("creative_id") @db.Uuid
  creativeVersionId String     @map("creative_version_id") @db.Uuid
  kind              RenderKind @default(VIDEO)
  frame             Int?
  status            JobStatus  @default(QUEUED)
  progress          Int        @default(0)
  /// Job id inside render, for polling.
  externalJobId     String?    @map("external_job_id")
  outputPath        String?    @map("output_path")
  error             String?
  durationMs        Int?       @map("duration_ms")
  createdAt         DateTime   @default(now()) @map("created_at")
  finishedAt        DateTime?  @map("finished_at")

  creative Creative        @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  version  CreativeVersion @relation(fields: [creativeVersionId], references: [id], onDelete: Cascade)

  @@index([creativeId, createdAt(sort: Desc)])
  @@index([status])
  @@map("render_jobs")
}

enum RenderKind {
  VIDEO
  STILL
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Performance data, imported from a Meta Ads CSV export while there is no API integration.
/// Kept as JSON because the useful field set keeps changing on Meta's side.
model CreativeMetric {
  id         String   @id @default(uuid()) @db.Uuid
  creativeId String   @map("creative_id") @db.Uuid
  source     String   @default("META_ADS_CSV")
  capturedAt DateTime @map("captured_at")
  windowDays Int      @default(1) @map("window_days")
  metrics    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([creativeId, capturedAt(sort: Desc)])
  @@map("creative_metrics")
}

/// Pipeline "Concorrentes" (TrendTrack → criativo próprio → rascunho na Meta). Uma linha por
/// anúncio vencedor encontrado; `stage` diz em que etapa ele está. O anúncio do concorrente vira
/// REFERÊNCIA (estrutura e ritmo) — nunca é reusado como footage nem tem a marca copiada.
model CompetitorAd {
  id           String   @id @default(uuid()) @db.Uuid
  appId        String   @map("app_id") @db.Uuid
  source       String   @default("trendtrack")
  externalId   String   @map("external_id")
  advertiser   String?
  pageId       String?  @map("page_id")
  mediaType    String?  @map("media_type")
  thumbnailUrl String?  @map("thumbnail_url")
  daysRunning  Int?     @map("days_running")
  reach        Float?
  /// Copy, transcrição, CTA e landing do anúncio original — vira o brief da IA.
  content      Json     @default("{}")
  /// Resposta crua do provedor, pra não precisar pagar de novo quando quisermos outro campo.
  raw          Json     @default("{}")
  /// SPOTTED → QUEUED → INGESTING → GENERATING → BROLL → RENDERING → READY
  ///   → DRAFT_QUEUED → DRAFTED  (ou FAILED / DISMISSED). Ver lib/pipeline.ts.
  stage        String   @default("SPOTTED")
  error        String?
  referenceId  String?  @map("reference_id") @db.Uuid
  creativeId   String?  @map("creative_id") @db.Uuid
  renderJobId  String?  @map("render_job_id") @db.Uuid
  /// IDs do que foi criado na Meta (vídeo, criativo, anúncio PAUSED) + link pro Gerenciador.
  meta         Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  app       App             @relation(fields: [appId], references: [id], onDelete: Cascade)
  reference ReferenceAsset? @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  creative  Creative?       @relation(fields: [creativeId], references: [id], onDelete: SetNull)

  @@unique([appId, source, externalId])
  @@index([appId, stage])
  @@map("competitor_ads")
}

// ---------------------------------------------------------------------------------------
// Estúdio de conteúdo orgânico: contas → postagens no calendário → takes → edição pela IA →
// aprovação → publicação. Ver lib/studio.ts.
// ---------------------------------------------------------------------------------------

/// Uma conta onde se posta (a da marca, a de um criador UGC, uma persona). Qualquer uma: o
/// time adiciona a que quiser e diz como ela fala e em que horários posta.
model SocialAccount {
  id             String    @id @default(uuid()) @db.Uuid
  appId          String    @map("app_id") @db.Uuid
  /// INSTAGRAM | TIKTOK. TikTok por enquanto é manual (baixa o MP4 e marca como postado).
  platform       String    @default("INSTAGRAM")
  handle         String
  displayName    String?   @map("display_name")
  avatarUrl      String?   @map("avatar_url")
  /// Quem é a pessoa por trás da conta e como ela fala — vai pro prompt de toda edição.
  persona        String?
  /// Estilo de edição padrão da conta (ritmo, legenda, música...). A instrução da postagem vence.
  style          String?
  /// Horários fixos do dia ("09:30"). O calendário mostra uma vaga por horário.
  slotTimes      String[]  @default([]) @map("slot_times")
  timezone       String    @default("America/Sao_Paulo")
  /// Pasta do Google Drive de onde puxar takes (compartilhada "qualquer pessoa com o link").
  driveFolder    String?   @map("drive_folder")
  /// Publica sozinho no horário depois de aprovado (só com a conta conectada).
  autoPublish    Boolean   @default(true) @map("auto_publish")
  active         Boolean   @default(true)
  /// Instagram conectado (API do Instagram com login do Instagram). Token cifrado (AES-GCM).
  igUserId       String?   @map("ig_user_id")
  igUsername     String?   @map("ig_username")
  accessTokenEnc String?   @map("access_token_enc")
  tokenExpiresAt DateTime? @map("token_expires_at")
  connectedAt    DateTime? @map("connected_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  posts Post[]
  takes Take[]

  @@index([appId])
  @@map("social_accounts")
}

/// Uma postagem num horário de uma conta. `status` diz o que falta (ver lib/studio.ts):
///   DRAFT → QUEUED → PREPARING → EDITING → BROLL → RENDERING → REVIEW
///   REVIEW → (pedir alteração) REVISING → RENDERING → REVIEW
///   REVIEW → (aprovar) APPROVED → SCHEDULED → PUBLISHING → PUBLISHED   (ou FAILED)
model Post {
  id            String    @id @default(uuid()) @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  appId         String    @map("app_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  scheduledAt   DateTime  @map("scheduled_at")
  status        String    @default("DRAFT")
  title         String?
  /// Como editar: o que o time escreveria pro editor humano.
  instructions  String?
  /// Legenda do post (a IA escreve se estiver vazia).
  caption       String?
  referenceId   String?   @map("reference_id") @db.Uuid
  creativeId    String?   @map("creative_id") @db.Uuid
  renderJobId   String?   @map("render_job_id") @db.Uuid
  /// Cópia pública do MP4 aprovado (servida em /assets) — o Instagram baixa daqui.
  videoFile     String?   @map("video_file")
  /// Pedido de alteração em andamento; o histórico fica em `revisions`.
  revisionNote  String?   @map("revision_note")
  /// [{ at, note, version }] — cada "pedir alteração", na ordem.
  revisions     Json      @default("[]")
  /// Token do link de envio sem login (criadores sobem takes pelo celular).
  uploadToken   String    @unique @default(uuid()) @map("upload_token")
  approvedAt    DateTime? @map("approved_at")
  /// Container de mídia do Instagram (retomar a publicação sem subir de novo).
  igContainerId String?   @map("ig_container_id")
  externalId    String?   @map("external_id")
  permalink     String?
  publishedAt   DateTime? @map("published_at")
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  account   SocialAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  app       App             @relation(fields: [appId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference ReferenceAsset? @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  creative  Creative?       @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  takes     Take[]

  @@index([accountId, scheduledAt])
  @@index([status, updatedAt])
  @@map("posts")
}

/// Um vídeo gravado (ou gerado) que a IA usa como matéria-prima. Chega por upload, link, pasta
/// do Drive, link de envio ou geração na kie.ai; o worker normaliza, tira a miniatura e transcreve
/// com o tempo de cada palavra — é pela fala que a IA escolhe onde cortar.
model Take {
  id           String   @id @default(uuid()) @db.Uuid
  appId        String   @map("app_id") @db.Uuid
  accountId    String?  @map("account_id") @db.Uuid
  postId       String?  @map("post_id") @db.Uuid
  /// UPLOAD | LINK | DRIVE | SENDER (link de envio) | KIE
  source       String   @default("UPLOAD")
  sourceUrl    String?  @map("source_url")
  /// Id do arquivo na origem (Drive) — evita importar duas vezes.
  sourceId     String?  @map("source_id")
  originalName String?  @map("original_name")
  /// Arquivo como chegou (antes de normalizar).
  rawPath      String?  @map("raw_path")
  /// Nome do MP4 normalizado e da miniatura em STORAGE_DIR/assets (servidos em /assets).
  file         String?
  thumbFile    String?  @map("thumb_file")
  durationMs   Int?     @map("duration_ms")
  width        Int?
  height       Int?
  hasAudio     Boolean  @default(true) @map("has_audio")
  /// { language, text, words: [{ word, startMs, endMs }] }
  transcript   Json?
  /// Pra take gerado: prompt e id da tarefa na kie.ai.
  prompt       String?
  providerTask String?  @map("provider_task")
  /// QUEUED (chegou) → GENERATING (kie) → PROCESSING → DONE | FAILED
  status       String   @default("QUEUED")
  error        String?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  app     App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  account SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  post    Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status, createdAt])
  @@map("takes")
}
