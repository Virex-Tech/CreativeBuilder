NODE_ENV=development
PORT=11200

# Postgres. No VPS, o docker-compose sobe este banco.
DATABASE_URL=postgresql://creativebuilder:creativebuilder@localhost:5440/creativebuilder

# Redis (BullMQ)
REDIS_URL=redis://localhost:6390

# JWT — mínimo 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=troque_isto_por_32_caracteres_ou_mais_aleatorios
JWT_EXPIRATION=30d

# Serviço de render (render)
RENDER_SERVICE_URL=http://localhost:11100

# Onde ficam os arquivos. Num VPS único, é um volume compartilhado entre os containers —
# por isso S3 ainda não é necessário. A interface de storage permite trocar depois.
STORAGE_DIR=./storage

# Origens permitidas no CORS (o front)
ALLOWED_ORIGINS=http://localhost:3000

# IA: nenhuma chave aqui. Spec, b-roll (Higgsfield CLI/MCP) e diagnóstico rodam no Claude
# Code de quem opera; os endpoints de IA do servidor respondem 503 — ver docs/ATIVACAO-IA.md.
