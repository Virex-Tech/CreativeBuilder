# docker-compose lê este arquivo
POSTGRES_PASSWORD=troque_esta_senha
JWT_SECRET=gere_com_openssl_rand_hex_32_pelo_menos_32_chars
# URL pública da API, vista pelo NAVEGADOR (não é o nome do container).
# É embutida no bundle do front na hora do build — mudou, precisa rebuildar o web.
PUBLIC_API_URL=http://SEU_IP_OU_DOMINIO:11200

# Origens que a API aceita no CORS — o endereço do front.
ALLOWED_ORIGINS=http://SEU_IP_OU_DOMINIO:3000
RENDER_CONCURRENCY=2

# URL pública da API — usada pra servir os assets de b-roll baixados por uma URL que o
# render e o navegador alcançam (assim o asset não some quando a URL do Higgsfield expira).
# Normalmente igual ao PUBLIC_API_URL. Vazio = mantém a URL do provedor (~7 dias) no spec.
PUBLIC_API_BASE=https://SEU_IP_OU_DOMINIO:11200

# Fase 2 — a IA escreve/edita o CreativeSpec (gerar do brief/referência, ajustar em
# linguagem natural). Sem a chave, os endpoints /creatives/generate e /creatives/:id/adjust
# respondem 503; o resto da plataforma funciona normal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Fase 3 — geração de b-roll no Higgsfield (camadas generative_video). Credenciais
# server-side criadas em cloud.higgsfield.ai. O path do modelo de vídeo varia por modelo
# (Seedance/Kling/...) — confirmar no cloud e preencher HIGGSFIELD_VIDEO_ENDPOINT
# (ex: /higgsfield-ai/<modelo>/<versao>). Sem as 3 primeiras, os endpoints respondem 503.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_VIDEO_ENDPOINT=
# opcional: body extra no submit (ex: {"model":"seedance-2.0","duration":5})
HIGGSFIELD_VIDEO_PARAMS={}
