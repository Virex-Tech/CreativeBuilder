# docker-compose lê este arquivo
POSTGRES_PASSWORD=troque_esta_senha
JWT_SECRET=gere_com_openssl_rand_hex_32_pelo_menos_32_chars
# URL pública da API, vista pelo NAVEGADOR (não é o nome do container).
# É embutida no bundle do front na hora do build — mudou, precisa rebuildar o web.
PUBLIC_API_URL=http://SEU_IP_OU_DOMINIO:11200

# Origens que a API aceita no CORS — o endereço do front.
ALLOWED_ORIGINS=http://SEU_IP_OU_DOMINIO:3000
RENDER_CONCURRENCY=2

# IA: spec e diagnóstico rodam no Claude Code / Codex de quem opera — ver docs/ATIVACAO-IA.md.
#
# B-roll NA PLATAFORMA (Fase 3): provedor selecionável na UI do criativo.
#   BROLL_PROVIDER = default quando a UI não escolhe (cai no 1º habilitado se esse faltar).
#   kie.ai: basta a key (jeito mais simples). Higgsfield: precisa dos 3 campos.
BROLL_PROVIDER=kie
KIE_API_KEY=
# opcional (default = Seedance 1.5 Pro, b-roll barato; mesmos ids do tools/kie.mjs):
#   KIE_MODEL=bytedance/seedance-1.5-pro  ·  KIE_VIDEO_PARAMS={"resolution":"720p","duration":5}
# Higgsfield (alternativa): HIGGSFIELD_API_KEY_ID / HIGGSFIELD_API_KEY_SECRET / HIGGSFIELD_VIDEO_ENDPOINT

# Pipeline "Concorrentes" (/apps/<id>/concorrentes): TrendTrack → IA + b-roll + render → Meta.
#   01 TrendTrack: chave do workspace (tt_live_…), com a Public API habilitada pelo admin.
TRENDTRACK_API_KEY=
#   03 Meta: token de System User com ads_management + id da conta de anúncios. O anúncio é
#   criado SEMPRE pausado; página/conjunto/link também podem ser definidos por app na tela.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# opcionais (defaults p/ todos os apps): META_PAGE_ID / META_ADSET_ID / META_INSTAGRAM_USER_ID / META_API_VERSION=v23.0
#   01 alternativa grátis: API oficial da Biblioteca de Anúncios (só anúncio comercial veiculado
#   na UE/UK). Token de usuário com acesso à Ad Library API (verificação em facebook.com/ID).
#   Vazio = tenta o META_ACCESS_TOKEN. Sem nenhuma fonte, a tela ainda aceita link manual.
META_AD_LIBRARY_TOKEN=
# O laço que avança as etapas roda dentro da API; PIPELINE_ENABLED=false desliga.
